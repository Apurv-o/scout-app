# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/scout"

# 32-byte hex key used to encrypt the stored YouTube API key at rest.
# Generate one with: openssl rand -hex 32
ENCRYPTION_SECRET="replace-with-64-hex-characters"

# Optional server-side YouTube Data API v3 key.
YOUTUBE_API_KEY="replace-with-your-youtube-api-key"

# Optional: override default public API endpoints for decentralized sources.
DTUBE_NODE_URL="https://api.dtube.io"
BITCHUTE_API_URL="https://www.bitchute.com/api/search/list/"
LBRY_API_URL="https://lbry.tech/api/v1/search"
